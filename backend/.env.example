# MySQL (独立的新研究数据库，不连接旧 stock_analysis 数据库)
RESEARCH_MYSQL_HOST=127.0.0.1
RESEARCH_MYSQL_PORT=3306
RESEARCH_MYSQL_DATABASE=stock_research
RESEARCH_MYSQL_USER=stock_research_app
RESEARCH_MYSQL_PASSWORD=replace_with_a_strong_password

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Application security
AUTH_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
AUTH_COOKIE_SECURE=false

# OpenAI-compatible model endpoint
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_MODEL=your-model-name

ENVIRONMENT=development
LOG_LEVEL=INFO
